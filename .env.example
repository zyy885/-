# ===== 后端环境变量 =====
# 生产环境必须设置！不要使用默认值
JWT_SECRET=your-very-long-secret-key-here-change-this

# 数据库连接（生产环境使用PostgreSQL）
# 本地开发可以留空，自动使用SQLite
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 允许的前端域名（逗号分隔），用于CORS
# 示例：https://vocab-app.vercel.app,https://your-domain.com
ALLOWED_ORIGINS=

# 服务端口（默认3001）
PORT=3001

# ===== 前端环境变量 =====
# 部署到Vercel时，在Vercel后台设置这个变量
# 指向你的后端API地址
VITE_API_BASE=https://your-backend-api.com/api
